{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/MillerAdulu/africastalking-php.git"
        }
    ],
    "require": {
        "php": "^8.5",
        "africastalking/africastalking": "dev-master",
        "azure-oss/storage-blob-laravel": "^1.3",
        "cheesegrits/filament-google-maps": "^5.0",
        "dedoc/scramble": "^0.13",
        "fakerphp/faker": "^1.24",
        "filament/filament": "^5.0",
        "filament/spatie-laravel-media-library-plugin": "^5.0",
        "giggsey/libphonenumber-for-php": "^9.0",
        "google/apiclient": "^2.18",
        "joelbutcher/socialstream": "6.3",
        "kreait/firebase-php": "^7.23",
        "laravel-notification-channels/fcm": "^6.0",
        "laravel/framework": "^12.49",
        "laravel/jetstream": "^5.3",
        "laravel/pulse": "^1.5",
        "laravel/reverb": "^1.6",
        "laravel/sanctum": "^4.3",
        "laravel/socialite": "^5.24",
        "laravel/telescope": "^5.16",
        "laravel/tinker": "^2.10",
        "league/flysystem-aws-s3-v3": "^3.31",
        "livewire/livewire": "^4.0",
        "maatwebsite/excel": "^3.1",
        "phpoffice/phpspreadsheet": "^1.29",
        "socialiteproviders/google": "^4.1",
        "spatie/browsershot": "^5.1",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-backup": "^9.3",
        "spatie/laravel-medialibrary": "^11.17",
        "spatie/laravel-pdf": "^1.7",
        "spatie/laravel-permission": "^6.24",
        "spatie/laravel-query-builder": "^6.4",
        "spatie/laravel-sluggable": "^3.7",
        "spatie/temporary-directory": "^2.3",
        "tapp/filament-timezone-field": "^3.0",
        "ysfkaya/filament-phone-input": "dev-filament-v5-support"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.0",
        "barryvdh/laravel-ide-helper": "^3.6",
        "laradumps/laradumps": "^5.0",
        "larastan/larastan": "^3.9",
        "laravel/boost": "^2.0",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.8",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/AutoloadHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
