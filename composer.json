{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The skeleton application for the Laravel framework.",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/joelbutcher/socialstream.git"
        },
        {
            "type": "vcs",
            "url": "https://github.com/laravel-shift/laravel-new-relic.git"
        },
        {
            "type": "git",
            "url": "https://github.com/MillerAdulu/africastalking-php.git"
        }
    ],
    "require": {
        "php": "^8.3",
        "africastalking/africastalking": "dev-master",
        "althinect/filament-spatie-roles-permissions": "^2.3",
        "azure-oss/storage-blob-laravel": "^1.3",
        "cheesegrits/filament-google-maps": "^3.0",
        "dedoc/scramble": "^0.12.11",
        "fakerphp/faker": "^1.24",
        "filament/filament": "^3.3",
        "filament/spatie-laravel-media-library-plugin": "^3.3",
        "giggsey/libphonenumber-for-php": "^8.13",
        "inspector-apm/inspector-laravel": "^4.11",
        "joelbutcher/socialstream": "6.x-dev",
        "laravel/framework": "^12.0",
        "laravel/jetstream": "^5.3",
        "laravel/reverb": "^1.4",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.18",
        "laravel/telescope": "^5.5",
        "laravel/tinker": "^2.10",
        "league/flysystem-aws-s3-v3": "^3.29",
        "livewire/livewire": "^3.6",
        "maatwebsite/excel": "^3.1",
        "phpoffice/phpspreadsheet": "^1.29",
        "rawilk/filament-password-input": "^2.0",
        "socialiteproviders/google": "^4.1",
        "spatie/laravel-activitylog": "^4.10",
        "spatie/laravel-medialibrary": "^11.12",
        "spatie/laravel-permission": "^6.16",
        "spatie/laravel-query-builder": "^6.3",
        "spatie/laravel-sluggable": "^3.7",
        "tapp/filament-timezone-field": "^3.0",
        "ysfkaya/filament-phone-input": "^3.1",
        "jackwh/laravel-new-relic": "dev-l12-compatibility"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^3.15",
        "barryvdh/laravel-ide-helper": "^3.5",
        "laradumps/laradumps": "^4.0",
        "laravel/pint": "^1.21",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.7",
        "pestphp/pest": "^3.7",
        "pestphp/pest-plugin-laravel": "^3.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        },
        "files": [
            "app/Helpers/AutoloadHelper.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force",
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
