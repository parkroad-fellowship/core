includes:
    - phpstan-baseline.neon
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/

    # Level 10 is the highest level
    level: 10

#    ignoreErrors:
#        - '#PHPDoc tag @var#'
#
#    excludePaths:
#        - ./*/*/FileToBeExcluded.php

services:
    -
        class: PRF\PHPStan\Rules\NoQueryBuilderWritesRule
        tags:
            - phpstan.rules.rule
